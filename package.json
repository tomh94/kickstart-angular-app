{
  "name": "kickstart-angular-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "model:generate": "npx tsx ./scripts/generateModel.ts",
    "model:import": "npx tsx ./scripts/importProject.ts",
    "env:sync": "npx tsx ./scripts/syncEnv.ts",
    "postinstall": "npm run env:sync",
    "setup": "npm run env:sync && npm run model:import --filename='scripts/backups/kickstart-completed.zip'",
    "lint": "eslint \"src/**/*.ts\"",
    "biome:fix": "biome check --fix .",
    "biome:check": "biome check .",
    "biome:ci": "biome ci ."
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^21.2.13",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@biomejs/biome": "^2.4.15",
    "@kontent-ai/data-ops": "^2.6.2",
    "@kontent-ai/delivery-sdk": "^16.4.3",
    "@kontent-ai/rich-text-resolver": "^3.0.3",
    "@tailwindcss/postcss": "^4.3.0",
    "dotenv": "^17.4.2",
    "nvm": "^0.0.4",
    "postcss": "^8.5.15",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.13",
    "@kontent-ai/biome-config": "^0.7.0",
    "@kontent-ai/core-sdk": "^10.12.5",
    "@kontent-ai/eslint-config": "^2.4.1",
    "@kontent-ai/model-generator": "^10.0.1",
    "@types/node": "^25.9.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6"
  }
}
